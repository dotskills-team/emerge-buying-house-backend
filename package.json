{
  "name": "buying-house-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "tsx --import ./src/test/setup.ts --test \"src/**/*.test.ts\"",
    "seed:admin": "tsx src/scripts/create-admin.ts",
    "seed:chatbot": "tsx src/scripts/seed-chatbot.ts",
    "migrate": "tsx src/scripts/migrate.ts"
  },
  "dependencies": {
    "cloudinary": "2.11.0",
    "cors": "2.8.6",
    "dotenv": "18.0.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jose": "^6.2.12",
    "mongoose": "9.11.2",
    "morgan": "1.12.1",
    "sanitize-html": "2.17.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/morgan": "1.9.10",
    "@types/node": "22.20.5",
    "@types/sanitize-html": "2.16.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "mongodb-memory-server": "10.2.3",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
