NODE_ENV=development
PORT=5000
# MongoDB must be a replica set (MongoDB Atlas is): user and role changes run in transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/buying-house
# The frontend's origin. Used for CORS, the CSRF origin check, and password-reset links.
CLIENT_ORIGIN=http://localhost:3000

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
SESSION_MAX_DAYS=30

# Password reset email via Resend (https://resend.com). Both are required for forgot-password to work;
# EMAIL_FROM must use a domain verified in Resend, e.g. "Emerge Buying House <no-reply@yourdomain.com>".
RESEND_API_KEY=
EMAIL_FROM=
PASSWORD_RESET_TTL_MINUTES=30
APP_NAME=Emerge Buying House
